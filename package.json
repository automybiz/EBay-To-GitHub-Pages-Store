{
  "name": "ebay-to-github-pages-store",
  "version": "1.0.0",
  "description": "EBay Invoice to GitHub Pages Store & Sync Engine",
  "bundleConfig": {
    "retentionDays": 30,
    "targetFolders": [
      "assets"
    ],
    "includeRootFiles": true
  },
  "scripts": {
